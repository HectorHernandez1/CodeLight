{
    "name": "codelight",
    "version": "1.6.5",
    "description": "A lightweight, minimalist code editor for macOS",
    "main": "src/main.js",
    "author": "Hector",
    "license": "MIT",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder",
        "build:mac": "electron-builder --mac",
        "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper || true"
    },
    "dependencies": {
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "electron-updater": "^6.7.3",
        "monaco-editor": "^0.45.0",
        "node-pty": "^1.1.0"
    },
    "devDependencies": {
        "electron": "^27.0.0",
        "electron-builder": "^24.9.1"
    },
    "allowScripts": {
        "electron@27.0.0": true,
        "node-pty@1.1.0": true
    }
}
